# --- Exchange rates (UAH-based) — converts stored UAH prices to USD for the en locale ---
# Rates API base URL (ExchangeRate-API v6 style; request path is <url>/<key>/latest/UAH)
EXCHANGE_RATE_API_URL=
# Rates API key
EXCHANGE_RATE_API_KEY=

# --- Checkout ---
# External order-relay service the checkout posts each order to
PLACE_ORDER_URL=
# Server-only, optional: presented to the relay as the x-relay-secret header; without it the relay must have its own check off
# Printable ASCII only: our own rule, stricter than HTTP needs, so that a bad paste can never reach a log through an error message
# A value that breaks it makes checkout answer 503 and log that it did — the value itself is never logged
ORDER_RELAY_SECRET=

# --- Нова Пошта directory (uk checkout autocomplete) ---
# Server-only, optional: without it the uk checkout falls back to free-text city and warehouse fields
NOVA_POSHTA_API_KEY=
